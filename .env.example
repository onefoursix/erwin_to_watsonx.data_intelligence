# Copy to .env (git ignores it) and fill in. Environment variables of the same name, in upper case, win.

# watsonx.data intelligence (SaaS): all three skills' wxdi steps
ibm_cloud_api_key=
di_service_url=https://api.ca-tor.dai.cloud.ibm.com

# SQL Server (wxdi-metadata-import --db sqlserver): the admin login, which creates the schema and the reader
sqlserver_host=
sqlserver_port=1433
sqlserver_db=
sqlserver_user=
sqlserver_password=

# PostgreSQL (wxdi-metadata-import --db postgres)
postgres_host=
postgres_port=5432
postgres_database=postgres
postgres_user=
postgres_password=
postgres_sslmode=require
# CA certificate wxdi should trust, if the server's isn't from a public CA (e.g. Aiven): paste the PEM,
# BEGIN to END lines, after postgres_cert= ... or point to a file with postgres_ssl_certificate_file=
# postgres_cert=-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----

# The read-only login's password: wxdi-metadata-import's reader step generates it here as <schema>_reader_password
